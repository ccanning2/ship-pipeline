# Pipeline configuration for THIS project (sourced by pipeline scripts). No secrets here.
PROJECT_NAME="ship-pipeline"
GIT_HOST="github"             # github | gitlab | bitbucket
GIT_HOST_URL=""               # empty = github.com
BASE_BRANCH="master"          # merging here deploys to dev and builds the image
STAGING_BRANCH="staging"      # pushing here deploys to qa; the same sha is then dispatched to staging
PIPELINE_REMOTE="origin"      # the git remote on the code host (GitHub); every fetch, push and merge uses it
# Project capabilities: yes | no. Default yes (= the stricter, original behaviour) when absent,
# empty or unrecognised; only an explicit "no" turns a capability off.
PIPELINE_START_LEVEL="analysis"   # analysis | engineering | devops | qa
PIPELINE_HAS_DEPLOY_ENVS="no"  # the artefact is the plugin itself: no image, no host, nothing to deploy to
DEPLOY_MODE="merge"            # merge | explicit (moot here: nothing deploys)
DEPLOY_WORKFLOW=""             # no deploy run to wait on
DEV_URL="https://github.com/ccanning2/ship-pipeline/tree/master"          # dev = the master ref
QA_URL="https://github.com/ccanning2/ship-pipeline/tree/staging"          # qa = the staging ref
STAGING_URL="https://github.com/ccanning2/ship-pipeline/tree/staging"     # staging = that same sha
PRODUCTION_URL="https://github.com/ccanning2/ship-pipeline/releases"      # production = the vX.Y.Z tag
HEALTH_PATH=""                 # no service to health-check
TRACKER="linear"              # jira | linear | github | gitlab | connector
TRACKER_URL=""
TRACKER_CLOUD_ID=""
TRACKER_TEAM_KEY="SHI"
# Ticket ids are <TEAM KEY>-<number>, matched case-insensitively (scripts/pipeline/ticket-id.sh).
PIPELINE_TICKET_REGEX="${TRACKER_TEAM_KEY:-}-[0-9]+"
