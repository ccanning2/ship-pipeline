# Pipeline configuration for THIS project (sourced by pipeline scripts). No secrets here.
# /pipeline-init writes every value from the owner's answers; edit by hand only to change an answer.
PROJECT_NAME="__PROJECT_NAME__"
# ---- code host ----
GIT_HOST="__GIT_HOST__"          # github | gitlab | bitbucket
GIT_HOST_URL="__GIT_HOST_URL__"  # empty = the public service; otherwise the self-hosted base URL (https://git.example.com)
PIPELINE_REMOTE="origin"         # the git remote on the code host; every fetch, push and merge uses it
# ---- branching ----
BASE_BRANCH="__BASE_BRANCH__"          # trunk: merging here deploys to dev and builds the image
STAGING_BRANCH="__STAGING_BRANCH__"    # pushing here deploys to qa; the same sha is then dispatched to staging
# ---- tracker ----
TRACKER="__TRACKER__"            # jira | linear | github | gitlab | connector (an MCP connector, when no CLI fits)
TRACKER_URL="__TRACKER_URL__"    # Jira site (https://acme.atlassian.net), Linear workspace URL, or empty for the code host
TRACKER_CLOUD_ID="__TRACKER_CLOUD_ID__"  # Jira only: the site's cloudId (/pipeline-init looks it up)
TRACKER_TEAM_KEY="__TEAM_KEY__"  # ticket prefix: ABC for ABC-12 (Jira project key, Linear team key, or a prefix for issue numbers)
# Ticket ids are <TEAM KEY>-<number>, matched case-insensitively. Keep it narrow: a broad pattern such as
# [A-Z][A-Z0-9]+-[0-9]+ also matches runner labels and image tags (macos-14, utf-8, v1.45.0-jammy).
# The hook, the gate, intake and the CI gate read it through scripts/pipeline/ticket-id.sh.
PIPELINE_TICKET_REGEX="${TRACKER_TEAM_KEY:-}-[0-9]+"
# ---- where /ship picks a ticket up ----
PIPELINE_START_LEVEL="__START_LEVEL__"  # analysis (product owner + BA) | engineering (tickets arrive ready for dev) | devops (built, ready to promote) | qa (already on qa)
# ---- project capability: yes | no. Absent, empty or unrecognised means yes (the stricter behaviour) ----
PIPELINE_HAS_DEPLOY_ENVS="yes" # no -> promote.sh skips the deploy wait, the staging dispatch and smoke
# ---- deployment ----
DEPLOY_MODE="__DEPLOY_MODE__"    # merge: pushes and tags deploy (staging is dispatched) | explicit: promote.sh dispatches every environment
DEPLOY_WORKFLOW="deploy.yml"     # GitHub Actions workflow file; empty when the project has no deployable environments
DEV_URL="__DEV_URL__"
QA_URL="__QA_URL__"
STAGING_URL="__STAGING_URL__"
PRODUCTION_URL="__PRODUCTION_URL__"
HEALTH_PATH="__HEALTH_PATH__"
