# Pipeline configuration for THIS project (sourced by pipeline scripts). No secrets here.
PROJECT_NAME="__PROJECT_NAME__"
BASE_BRANCH="master"          # merging here deploys to dev and builds the image
STAGING_BRANCH="staging"      # pushing here deploys to qa; the same sha is then dispatched to staging
# Project capabilities: yes | no. Default yes (= the stricter, original behaviour) when absent,
# empty or unrecognised; only an explicit "no" turns a capability off.
PIPELINE_HAS_DEPLOY_ENVS="yes" # no -> promote.sh skips the deploy wait, the staging dispatch and smoke
PIPELINE_HAS_MARKETING="yes"   # no -> the marketing persona and the production marketing gate are skipped
DEPLOY_WORKFLOW="deploy.yml"  # empty when the project has no deployable environments
DEV_URL="__DEV_URL__"
QA_URL="__QA_URL__"
STAGING_URL="__STAGING_URL__"
PRODUCTION_URL="__PRODUCTION_URL__"
HEALTH_PATH="__HEALTH_PATH__"
TRACKER="linear"              # linear | jira
TRACKER_TEAM_KEY="__TEAM_KEY__"
PIPELINE_TICKET_REGEX="${PIPELINE_TICKET_REGEX:-[A-Z][A-Z0-9]+-[0-9]+}"
